<Window x:Class="Orynivo.YearInReviewDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_YearInReview}"
        Icon="avares://Orynivo/Assets/Orynivo.ico"
        Width="720"
        Height="780"
        MinWidth="560"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppContentBrush}">
    <Window.Styles>
        <Style Selector="Button.dialogAction">
            <Setter Property="Background" Value="{DynamicResource AppButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppButtonTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="24,11"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource L_YearInReview}"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeBodyStrong}"
                       Foreground="{DynamicResource AppPrimaryTextBrush}"/>
            <ComboBox x:Name="YearComboBox"
                      Width="110"
                      Height="30"
                      VerticalAlignment="Center"
                      Background="{DynamicResource AppInputBrush}"
                      Foreground="{DynamicResource AppPrimaryTextBrush}"
                      BorderBrush="{DynamicResource AppButtonBorderBrush}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="ContentHost"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppButtonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="28"/>
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <TextBlock x:Name="StatusTextBlock"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeMeta}"
                       Foreground="{DynamicResource AppMutedTextBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveImageButton"
                        Classes="dialogAction"
                        Content="{DynamicResource L_SaveAsImage}"
                        Click="SaveImageButton_OnClick"/>
                <Button x:Name="SavePdfButton"
                        Classes="dialogAction"
                        Content="{DynamicResource L_SaveAsPdf}"
                        Click="SavePdfButton_OnClick"/>
                <Button Classes="dialogAction"
                        Content="{DynamicResource L_Close}"
                        Click="CloseButton_OnClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
